<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Wudland</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppleMusicUsageDescription</key>
	<string>Wudland reads your music library and recently played songs so the village bard can talk about what you have been listening to. Nothing leaves this iPhone.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Wudland reads your calendar events to show today’s and upcoming events in the Bell Tower. Your events stay on this iPhone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wudland uses your approximate location, rounded to your area, to fetch local weather from Open-Meteo for the village farmer. You can type a town in Settings instead.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Wudland reads your incomplete reminders to pin them on the village Notice Board, and lets you tick them off there. Your reminders stay on this iPhone.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Jacquard12-Regular.ttf</string>
		<string>PixelifySans.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
